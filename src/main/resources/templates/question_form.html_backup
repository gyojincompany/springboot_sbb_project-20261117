<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>질문 등록</title>
    <link rel="stylesheet" th:href="@{/css/question-form.css}">
</head>
<body>
    <div class="page-container">

        <!-- 페이지 제목 -->
        <div class="page-header">
            <h2 class="page-title">질문 등록</h2>
        </div>

        <!-- 질문 등록 폼 카드 -->
        <div class="card">
            <div class="card-header">새 질문 작성</div>
            <div class="card-body">
                <form th:action="@{/question/create}" method="post">
                    <div class="form-group">
                        <label for="subject" class="form-label">제목</label>
                        <input type="text"
                               id="subject"
                               name="subject"
                               class="form-input"
                               placeholder="질문 제목을 입력하세요."
                               required>
                    </div>

                    <div class="form-group">
                        <label for="content" class="form-label">내용</label>
                        <textarea id="content"
                                  name="content"
                                  class="form-textarea"
                                  placeholder="질문 내용을 입력하세요."
                                  required></textarea>
                    </div>

                    <div class="form-actions">
                        <a th:href="@{/question/list}" class="btn btn-secondary">목록으로</a>
                        <button type="submit" class="btn btn-primary">질문 등록</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</body>
</html>